# Copy this file to .env (in this same folder) and fill in your own values.
# Never commit .env: it holds your real API key.

# Portkey API key, used for all AI calls (model: gpt-5.6-luna).
PORTKEY_API_KEY=your-portkey-api-key-here

# Set to 1 only when the site is served over HTTPS, so login cookies are never sent over plain HTTP.
COOKIE_SECURE=0
